+def test_relative_window_rejects_measured_opening_as_target():
+    rng = np.random.default_rng(2)
+    targets = random_rows(rng, 3)
+    targets[1, 9] = .4
+    with pytest.raises(ValueError, match='binary'):
+        ee_relative_window(targets, random_rows(rng, 1)[0])
